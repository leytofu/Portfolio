# Local Vite server settings (not exposed to the browser).
DEV_PORT=5173
PREVIEW_PORT=4173

# Deployment path: use / for the root or /portfolio/ for a subdirectory.
VITE_BASE_PATH=/

# Browser-accessible variables must start with VITE_.
# VITE_ values are public: never use them for passwords or private API keys.

# Server-only contact API settings. Add these in Vercel Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Default sender can only deliver to the email registered with your Resend account.
# For other recipients, use a sender on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
